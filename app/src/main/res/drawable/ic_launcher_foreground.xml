<?xml version="1.0" encoding="utf-8"?>
<!--
  Aurum mark: a geometric "A" cut like a gold ingot — two flat facets meeting
  at a mitered peak, with a trapezoid crossbar set into the counter.
  Flat fills only; the light/dark facet split is the entire effect.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- left facet (light) -->
    <path
        android:pathData="M31,76 L54,30 L54,45 L42,76 Z"
        android:fillColor="#FFF1C468" />

    <!-- right facet (deep) -->
    <path
        android:pathData="M77,76 L54,30 L54,45 L66,76 Z"
        android:fillColor="#FFCE9C38" />

    <!-- crossbar, mid tone, edges parallel to the inner slopes -->
    <path
        android:pathData="M49,58 L59,58 L61.4,64 L46.6,64 Z"
        android:fillColor="#FFE3B455" />
</vector>
